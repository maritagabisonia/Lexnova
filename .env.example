# Copy this file to .env.local and replace the placeholders with values from
# your Supabase project: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site origin used for sitemap.xml, robots.txt, and metadataBase.
# Optional locally; set this in production (e.g. https://www.lexnova.org).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
